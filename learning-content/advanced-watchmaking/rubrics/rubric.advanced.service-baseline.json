{
  "id": "rubric.advanced.service-baseline",
  "version": "1.0.0",
  "competencyId": "competency.advanced.service-baseline",
  "rules": [
    {
      "id": "rule.advanced.service-baseline.demonstrated",
      "version": "1.0.0",
      "targetState": "demonstrated",
      "acceptedEvidenceKinds": [
        "human-review"
      ],
      "minimumEvidence": 1,
      "minimumScore": 0.8,
      "minimumDistinctSessions": 1,
      "minimumSpanDays": 0,
      "explanationTemplate": "Estado inicial, alcance y seguridad: una revisión humana confirma causalidad, procedencia, comparación, límites y transferencia."
    }
  ],
  "assessmentRule": {
    "id": "rule.composite.advanced.service-baseline",
    "version": "1.0.0",
    "competencyId": "competency.advanced.service-baseline",
    "targetState": "demonstrated",
    "condition": {
      "op": "all",
      "conditions": [
        {
          "op": "exists",
          "filter": {
            "evidenceType": "human-review",
            "status": "active",
            "minimumConfidence": 0.8
          }
        },
        {
          "op": "minimum-evidence",
          "count": 1
        }
      ]
    }
  }
}
