        "lessonId": "lesson.horology.quartz-chain",
        "activityId": "activity.horology.order-quartz-chain",
        "mode": "independent-practice",
        "evidenceLevel": "independent-simulation",
        "optional": false,
        "transferTargetIds": [
          "concept.horology.quartz-chain"
        ]
      },
      {
        "id": "milestone.horology.gold.07",
        "order": 6,
        "title": {
          "es": "Comparar cuarzo y mecánica"
        },
        "outcome": {
          "es": "Relacionar soluciones distintas que cumplen una función equivalente."
        },
        "lessonId": "lesson.horology.functional-equivalence",
        "activityId": "activity.horology.match-functional-equivalents",
        "mode": "transfer",
        "evidenceLevel": "transfer",
        "optional": false,
        "transferTargetIds": [
          "concept.horology.functional-equivalence"
        ]
      },
      {
        "id": "milestone.horology.gold.08",
        "order": 7,
        "title": {
          "es": "Predecir una interrupción"
        },
        "outcome": {
          "es": "Anticipar qué deja de ocurrir cuando una relación funcional se bloquea."
        },
        "lessonId": "lesson.horology.failure-prediction",
        "activityId": "activity.horology.predict-interruption",
        "mode": "guided-practice",
        "evidenceLevel": "causal-explanation",
        "optional": false,
        "transferTargetIds": [
          "concept.horology.system-interruption"
        ]
      },
      {
        "id": "milestone.horology.gold.09",
        "order": 8,
        "title": {
          "es": "Localizar el subsistema afectado"
        },
        "outcome": {
          "es": "Vincular un cambio observable con el subsistema que puede explicarlo."
        },
        "lessonId": "lesson.horology.failure-prediction",
        "activityId": "activity.horology.select-affected-subsystem",
        "mode": "independent-practice",
        "evidenceLevel": "transfer",
        "optional": false,
        "transferTargetIds": [
          "concept.horology.functional-chain"
        ]
      },
      {
        "id": "milestone.horology.gold.10",
        "order": 9,
        "title": {
          "es": "Justificar una hipótesis comprobable"
        },
        "outcome": {
          "es": "Cerrar el recorrido con una explicación causal, fuentes y límites."
        },
        "lessonId": "lesson.horology.failure-prediction",
        "activityId": "activity.horology.justify-hypothesis",
        "mode": "transfer",
        "evidenceLevel": "transfer",
        "optional": false,
        "transferTargetIds": [
          "concept.horology.system-interruption"
        ]
      },
      {
        "id": "milestone.horology.gold.04",
        "order": 10,
        "title": {
          "es": "Profundizar en la confianza documental"
        },
        "outcome": {
          "es": "Separar datos documentados, recuerdos e inferencias cuando necesites evaluar una fuente."
        },
        "lessonId": "lesson.horology.isa8172-confidence",
        "activityId": "activity.horology.isa-confidence-map",
        "mode": "transfer",
        "evidenceLevel": "transfer",
        "optional": true,
        "transferTargetIds": [
          "concept.horology.source-confidence"
        ]
      }
