    "competency.horology.explain-mechanical-energy-chain",
    "competency.horology.distinguish-regulation-from-transmission",
    "competency.horology.predict-system-interruption",
    "competency.horology.state-source-confidence"
  ],
  "movementIds": [
    "fixture.miyota.2035.structural",
    "fixture.miyota.8215.structural"
  ],
  "difficulty": "introductory",
  "sourceIds": [
    "source.miyota.2035.parts-list-exploded-view",
    "source.miyota.8215.parts-list-exploded-view",
    "source.horology.private-book.functional-systems",
    "source.horology.original-functional-map"
  ],
  "visualResourceIds": [
    "visual.horology.complete-watch-layers",
    "visual.horology.quartz-energy-flow",
    "visual.horology.miyota2035-structural",
    "visual.horology.isa8172-memory-map",
    "visual.horology.mechanical-energy-flow",
    "visual.horology.swiss-lever-slow-motion",
    "visual.horology.quartz-mechanical-overlay",
    "visual.horology.failure-simulation",
    "visual.horology.functional-text-alternative"
  ],
  "demo": false,
  "learningDesign": {
    "model": "gold-standard",
    "entryPolicy": "start-from-zero",
    "completionPolicy": "evidence",
    "milestones": [
      {
        "id": "milestone.horology.gold.01",
        "order": 1,
        "title": {
          "es": "Reconocer las funciones del reloj"
        },
        "outcome": {
          "es": "Distinguir fuente, control o regulación, transmisión, indicación y estructura."
        },
        "lessonId": "lesson.horology.system",
        "activityId": "activity.horology.classify-subsystems",
        "mode": "orientation",
        "evidenceLevel": "recognition",
        "optional": false,
        "transferTargetIds": [
          "concept.horology.functional-chain"
        ]
      },
      {
        "id": "milestone.horology.gold.05",
        "order": 2,
        "title": {
          "es": "Reconocer escape y oscilador"
        },
        "outcome": {
          "es": "Distinguir transmisión, liberación e impulsos en el modelo mecánico."
        },
        "lessonId": "lesson.horology.mechanical-chain",
        "activityId": "activity.horology.identify-escapement-oscillator",
        "mode": "explanation",
        "evidenceLevel": "causal-explanation",
        "optional": false,
        "transferTargetIds": [
          "concept.horology.mechanical-chain"
        ]
      },
      {
        "id": "milestone.horology.gold.06",
        "order": 3,
        "title": {
          "es": "Reconstruir la cadena mecánica"
        },
        "outcome": {
          "es": "Ordenar de forma independiente la energía desde el muelle hasta las agujas."
        },
        "lessonId": "lesson.horology.mechanical-chain",
        "activityId": "activity.horology.order-mechanical-chain",
        "mode": "independent-practice",
        "evidenceLevel": "independent-simulation",
        "optional": false,
        "transferTargetIds": [
          "concept.horology.mechanical-chain"
        ]
      },
      {
        "id": "milestone.horology.gold.02",
        "order": 4,
        "title": {
          "es": "Seguir la referencia temporal de cuarzo"
        },
        "outcome": {
          "es": "Localizar control electrónico, bobina, rotor paso a paso y transmisión."
        },
        "lessonId": "lesson.horology.quartz-chain",
        "activityId": "activity.horology.identify-time-reference",
        "mode": "explanation",
        "evidenceLevel": "causal-explanation",
        "optional": false,
        "transferTargetIds": [
          "concept.horology.quartz-chain"
        ]
      },
      {
        "id": "milestone.horology.gold.03",
        "order": 5,
        "title": {
          "es": "Reconstruir la cadena de cuarzo"
