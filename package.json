{
  "name": "relojes",
  "private": true,
  "version": "0.13.1",
  "type": "module",
  "scripts": {
    "prebuild": "npm run learning:schema",
    "dev": "vite",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-installer.ps1",
    "installer:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\build-installer.ps1 -SkipVerification",
    "installer:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\clean-stale-installers.ps1",
    "cad:test": ".venv-cad\\Scripts\\python.exe -m pytest cad-engine -q",
    "cad:package": ".venv-cad\\Scripts\\python.exe -m PyInstaller cad-engine\\watchlab-cad.spec --noconfirm --clean --distpath cad-engine\\dist --workpath cad-engine\\build",
    "build": "tsc -b && vite build",
    "learning:validate": "tsx scripts/learning-content.ts validate",
    "learning:lint": "tsx scripts/learning-content.ts lint",
    "learning:preview": "tsx scripts/learning-content.ts preview",
    "learning:pack": "tsx scripts/learning-content.ts pack",
    "learning:visual-report": "tsx scripts/learning-content.ts visual-report",
    "learning:fixture-report": "tsx scripts/learning-fixtures.ts",
    "learning:miyota-sources:verify": "tsx scripts/verify-miyota-official-sources.ts",
    "learning:system4d-audit": "tsx scripts/generate-system4d-audit.ts",
    "learning:system4d-generate": "node scripts/generate-horology-system4d.mjs",
    "learning:system4d-performance": "tsx scripts/measure-system4d-workbench.ts",
    "learning:system4e-audit": "tsx scripts/generate-system4e-audit.ts",
    "learning:system4e-generate": "node scripts/generate-horology-system4e.mjs",
    "learning:system4e-performance": "tsx scripts/measure-system4e-mechanical-lab.ts",
    "learning:system4f-audit": "tsx scripts/generate-system4f-audit.ts",
    "learning:system4f-generate": "tsx scripts/generate-horology-system4f.ts",
    "learning:system4f-performance": "tsx scripts/measure-system4f-calibre.ts",
    "learning:academy-upgrade": "node scripts/upgrade-academy-completeness.mjs",
    "learning:academy-p1": "node scripts/upgrade-academy-p1.mjs",
    "learning:academy-p1-audit": "node scripts/audit-academy-p1.mjs",
    "learning:academy-p2-audit": "node scripts/audit-academy-p2.mjs",
    "learning:theory-labs-upgrade": "node scripts/upgrade-mechanical-theory-labs.mjs",
    "learning:advanced-generate": "node scripts/generate-advanced-watchmaking.mjs",
    "learning:capstone-generate": "tsx scripts/generate-watchmaking-capstone.ts",
    "learning:encyclopedia-generate": "node scripts/generate-watchmaking-encyclopedia.mjs",
    "learning:content-quality-audit": "node scripts/audit-academy-content-quality.mjs",
    "learning:source-audit": "tsx scripts/academy-governance-audit.ts --scope=source",
    "learning:curriculum-audit": "tsx scripts/academy-governance-audit.ts --scope=curriculum",
    "learning:editorial-audit": "tsx scripts/academy-governance-audit.ts --scope=all",
    "learning:semantic-audit": "tsx scripts/academy-semantic-audit.ts",
    "learning:text-scale": "node scripts/normalize-learning-text-scale.mjs",
    "learning:schema": "node scripts/generate-learning-schema-validator.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run lint && npm run test && npm run learning:academy-p1-audit && npm run learning:academy-p2-audit && npm run learning:content-quality-audit && npm run learning:editorial-audit -- --check && npm run learning:semantic-audit -- --check && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "ajv": "^8.17.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.4",
    "globals": "^17.6.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
