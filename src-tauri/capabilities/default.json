{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop permissions for Watch Prototype Lab",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://miyotamovement.com/*" },
        { "url": "https://www.miyotamovement.com/*" },
        { "url": "https://www.citizen.co.jp/*" },
        { "url": "https://www.eta.ch/*" },
        { "url": "https://www.sellita.ch/*" },
        { "url": "https://www.seikowatches.com/*" },
        { "url": "https://www.bipm.org/*" },
        { "url": "https://www.nist.gov/*" },
        { "url": "https://nvlpubs.nist.gov/*" }
      ]
    }
  ]
}
